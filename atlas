#!/usr/bin/env bash
# Atlas local CLI: ./atlas up | down | restart | status | logs [name] | doctor | backup [dir]
#
# Infrastructure (Postgres, Redis) runs in Docker Compose. The application
# processes run natively, each in a restart loop, with logs in .atlas/logs
# and pids in .atlas/run. Every service binds to 127.0.0.1.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$ROOT/.atlas"
RUN="$STATE/run"
LOGS="$STATE/logs"
mkdir -p "$RUN" "$LOGS"

# name|working dir|command. Order is start order.
PROCS=(
  "api|backend|php artisan serve --host=127.0.0.1 --port=8000"
  "reverb|backend|php artisan reverb:start --host=127.0.0.1 --port=8080"
  "bridge|backend|php artisan atlas:bridge"
  "horizon|backend|php artisan horizon"
  "scheduler|backend|php artisan schedule:work"
  "trading_core|services|uv run --package atlas-trading-core python -m trading_core"
  "frontend|frontend|npm run dev"
)

say() { printf '\033[1m%s\033[0m %s\n' "atlas:" "$*"; }

port_open() { nc -z 127.0.0.1 "$1" >/dev/null 2>&1; }

load_app_key() {
  # Brief §18: APP_KEY lives in the macOS Keychain. A real env var wins over
  # backend/.env in Laravel and is read by trading_core the same way.
  if [[ -z "${APP_KEY:-}" ]] && command -v security >/dev/null; then
    if key="$(security find-generic-password -s atlas -a APP_KEY -w 2>/dev/null)"; then
      export APP_KEY="$key"
      say "APP_KEY loaded from Keychain (service atlas, account APP_KEY)"
    fi
  fi
}

ensure_reverb_secret() {
  # ATL-50 (security round 4, finding 1): an empty secret lets any web page forge a private-
  # channel subscription with HMAC(key=""). Generated the same way as APP_KEY (a random value
  # written into backend/.env on first run), before any process that reads it starts. Runs
  # before load_backend_env so the freshly written value, not an empty one, is what gets
  # exported and handed to every child process.
  local f="$ROOT/backend/.env"
  [[ -f "$f" ]] || { say "backend/.env is missing (copy backend/.env.example)"; exit 1; }
  local current
  current="$(grep -m1 '^REVERB_APP_SECRET=' "$f" 2>/dev/null | cut -d= -f2-)"
  current="${current%\"}"; current="${current#\"}"
  if [[ -z "$current" || "${#current}" -lt 32 ]]; then
    command -v openssl >/dev/null || { say "openssl is required to generate REVERB_APP_SECRET"; exit 1; }
    local secret tmp; secret="$(openssl rand -hex 32)"; tmp="$f.tmp.$$"
    if grep -q '^REVERB_APP_SECRET=' "$f"; then
      awk -v s="REVERB_APP_SECRET=$secret" '$0 ~ /^REVERB_APP_SECRET=/ { print s; next } { print }' "$f" >"$tmp" && mv "$tmp" "$f"
    else
      cp "$f" "$tmp" && printf 'REVERB_APP_SECRET=%s\n' "$secret" >>"$tmp" && mv "$tmp" "$f"
    fi
    say "generated REVERB_APP_SECRET in backend/.env (rotate: docs/RUNBOOK.md)"
    current="$(grep -m1 '^REVERB_APP_SECRET=' "$f" | cut -d= -f2-)"
  fi
  [[ "${#current}" -ge 32 ]] || { say "REVERB_APP_SECRET is still empty or under 32 chars in backend/.env"; exit 1; }
}

infra_up() {
  if port_open 5433 && port_open 6380; then
    say "Postgres :5433 and Redis :6380 already running"
    return
  fi
  docker info >/dev/null 2>&1 || { say "Docker is not running"; exit 1; }
  docker compose -f "$ROOT/docker-compose.yml" up -d --wait postgres redis
}

load_backend_env() {
  # trading_core reads DB_*, APP_KEY and INTERNAL_SHARED_SECRET from its
  # environment (decision #235); backend/.env is the one source. Variables
  # already set (e.g. APP_KEY from the Keychain) win.
  local f="$ROOT/backend/.env" line k v
  [[ -f "$f" ]] || { say "backend/.env is missing (copy backend/.env.example)"; exit 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    v="${v%\"}"; v="${v#\"}"
    [[ -z "${!k+x}" ]] && export "$k=$v"
  done <"$f"
}

sync_deps() {
  # Install only when a lockfile is newer than what is installed.
  if [[ "$ROOT/backend/composer.lock" -nt "$ROOT/backend/vendor/autoload.php" ]]; then
    (cd "$ROOT/backend" && composer install --no-interaction)
  fi
  if [[ "$ROOT/frontend/package-lock.json" -nt "$ROOT/frontend/node_modules/.package-lock.json" ]]; then
    (cd "$ROOT/frontend" && npm ci)
  fi
  (cd "$ROOT/services" && uv sync --python 3.12 --quiet)
}

has_command() { (cd "$ROOT/backend" && php artisan list --raw 2>/dev/null | grep -q "^$1 "); }

alive() { [[ -f "$RUN/$1.pid" ]] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }

start_proc() {
  local name="$1" dir="$2" cmd="$3"
  if alive "$name"; then say "$name already running"; return; fi
  rm -f "$RUN/$name.stop"
  # Restart loop: a crash restarts after 2 s; ./atlas down sets the stop flag.
  nohup bash -c '
    cd "$1"
    while :; do
      $2 & child=$!
      echo "$child" > "$3.child"
      trap "kill -TERM $child 2>/dev/null" TERM INT
      wait "$child"; code=$?
      [[ -f "$3.stop" ]] && exit 0
      echo "[atlas] $4 exited ($code), restarting in 2s"
      sleep 2
    done' _ "$ROOT/$dir" "$cmd" "$RUN/$name" "$name" >>"$LOGS/$name.log" 2>&1 &
  echo $! >"$RUN/$name.pid"
  say "started $name (log .atlas/logs/$name.log)"
}

stop_proc() {
  local name="$1"
  alive "$name" || { rm -f "$RUN/$name.pid" "$RUN/$name.child"; return 0; }
  touch "$RUN/$name.stop"
  local child; child="$(cat "$RUN/$name.child" 2>/dev/null || true)"
  [[ -n "$child" ]] && { pkill -TERM -P "$child" 2>/dev/null || true; kill -TERM "$child" 2>/dev/null || true; }
  for _ in $(seq 1 20); do alive "$name" || break; sleep 0.5; done
  alive "$name" && kill -KILL "$(cat "$RUN/$name.pid")" 2>/dev/null || true
  rm -f "$RUN/$name.pid" "$RUN/$name.child" "$RUN/$name.stop"
  say "stopped $name"
}

cmd_up() {
  load_app_key
  ensure_reverb_secret
  load_backend_env
  infra_up
  sync_deps
  (cd "$ROOT/backend" && php artisan migrate --force)
  for p in "${PROCS[@]}"; do
    IFS='|' read -r name dir cmd <<<"$p"
    if [[ "$cmd" == "php artisan atlas:bridge" ]] && ! has_command atlas:bridge; then
      say "skipping bridge: atlas:bridge is not in this checkout yet"; continue
    fi
    start_proc "$name" "$dir" "$cmd"
  done
  # Keep the Mac awake while Atlas runs (brief §18).
  if ! alive caffeinate; then
    nohup caffeinate -is >/dev/null 2>&1 & echo $! >"$RUN/caffeinate.pid"
  fi
  say "Atlas is up: http://localhost:3000"
}

cmd_down() {
  local i
  for ((i=${#PROCS[@]}-1; i>=0; i--)); do
    IFS='|' read -r name _ _ <<<"${PROCS[$i]}"; stop_proc "$name"
  done
  alive caffeinate && kill "$(cat "$RUN/caffeinate.pid")" 2>/dev/null || true
  rm -f "$RUN/caffeinate.pid"
  say "app processes stopped (Postgres and Redis keep running; 'docker compose stop' stops them)"
}

cmd_status() {
  for p in "${PROCS[@]}"; do
    IFS='|' read -r name _ _ <<<"$p"
    if alive "$name"; then printf '  %-13s running (pid %s)\n' "$name" "$(cat "$RUN/$name.pid")"
    else printf '  %-13s stopped\n' "$name"; fi
  done
  for pt in 5433:postgres 6380:redis 8000:api 8080:reverb 8100:trading_core 3000:frontend; do
    port_open "${pt%%:*}" && s=open || s=closed
    printf '  :%-5s %-13s %s\n' "${pt%%:*}" "${pt#*:}" "$s"
  done
}

cmd_logs() {
  if [[ -n "${1:-}" ]]; then tail -n 100 -f "$LOGS/$1.log"; else tail -n 20 -f "$LOGS"/*.log; fi
}

cmd_backup() {
  local dir="${1:-$ROOT/../backups}"; mkdir -p "$dir"
  local file="$dir/atlas-$(date -u +%Y%m%dT%H%M%SZ).dump"
  local pg; pg="$(docker ps --filter publish=5433 -q | head -1)"
  [[ -n "$pg" ]] || { say "Postgres on :5433 is not running"; exit 1; }
  docker exec "$pg" pg_dump -U atlas -Fc atlas >"$file"
  say "backup written to $file"
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  restart) cmd_down; cmd_up ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "${1:-}" ;;
  doctor) load_app_key; cd "$ROOT/backend" && exec php artisan atlas:doctor ;;
  backup) shift; cmd_backup "${1:-}" ;;
  *) echo "usage: ./atlas up|down|restart|status|logs [name]|doctor|backup [dir]"; exit 2 ;;
esac
