# Laravel API origin the SPA calls (Sanctum SPA cookie auth). Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Reverb (War Room live updates, src/lib/echo.ts). Defaults match backend/.env.example's REVERB_*:
# key atlas-local-key on 127.0.0.1:8080 over plain ws. VITE_REVERB_APP_KEY must equal REVERB_APP_KEY.
VITE_REVERB_APP_KEY=atlas-local-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
