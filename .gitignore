# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Kept out of history by CCQ.
# Secrets: the example file is the one to commit.
.env
.env.*
!.env.example

# Test output. It goes in the project's evidence folder, beside this repository.
screenshots/
test-results/
playwright-report/

# CCQ's code-graph cache, which the graph tool leaves in what it scans.
graphify-out/

# Dependencies: installed from the lockfile, never committed — in history
# they bury the real changes under thousands of files.
node_modules/
/vendor/
/*/vendor/
Pods/
.gradle/

# Python
.venv/
__pycache__/

# CCQ's code graph. Not yours to keep.
.graphifyignore
