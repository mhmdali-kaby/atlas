APP_NAME=Atlas
APP_ENV=local
APP_KEY=
# Off in the shipped env: with debug on, an unhandled exception on /api/* (for example a
# DecryptException after an APP_KEY change) returns file paths and a stack trace to the browser.
# Turn it on only for local development, never in a file the owner's install writes.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=atlas
DB_USERNAME=atlas
DB_PASSWORD=atlas
# Tests (Pest and pytest) use their own database per checkout: atlas_test_<first 8 hex of
# sha1(realpath of the repo root)>, created on the first `php artisan test`. Set this to force one
# name instead (for example DB_TEST_DATABASE=atlas_test). Export it in the shell: phpunit sets the
# test DB before this file is read.
# DB_TEST_DATABASE=

# 15 minutes server-side: a closed or crashed tab can't leave a long-lived session cookie valid.
# The SPA's own 15-minute idle lock (IDLE_LOCK_MS) is client-side only and signs the owner out of
# the UI well before this; a tab left open and polling keeps the session alive, by design.
SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSockets to the SPA) and the War Room bridge. Two long-running processes, both started
# by `./atlas up`: `php artisan reverb:start` (127.0.0.1:8080) and `php artisan atlas:bridge`
# (Redis Streams atlas.* -> warroom_messages -> Reverb private-warroom/-account/-system; consumer
# group "bridge"; SIGTERM exits 0). The bridge broadcasts through BROADCAST_CONNECTION=reverb using
# the REVERB_* values below; the bus is the `events` Redis connection (REDIS_* above).
REVERB_APP_ID=atlas
REVERB_APP_KEY=atlas-local-key
# Left empty here on purpose: `./atlas up` generates a real one (openssl rand -hex 32) into
# backend/.env on first run, the same way APP_KEY is handled. An empty or <32-char secret lets
# any web page forge a private-channel subscription, so atlas:doctor fails on it too. Rotate it
# with docs/RUNBOOK.md "Rotate keys".
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# The Reverb server process binds here (brief §18: every service on 127.0.0.1 only).
REVERB_SERVER_HOST=127.0.0.1

# --- Atlas ---
# The React SPA origin (scheme://host:port). CORS (with credentials) allows only this origin, and
# Sanctum treats only this host:port (plus APP_URL) as stateful for the session cookie.
FRONTEND_URL=http://localhost:3000
SESSION_DOMAIN=localhost
# Internal FastAPI trading core (services/trading_core). Calls are HMAC-signed with the secret below.
TRADING_CORE_URL=http://127.0.0.1:8100
INTERNAL_SHARED_SECRET=
# Active environment at first boot. Live needs the in-app guarded switch, never this file.
ATLAS_DEFAULT_ENV=demo
